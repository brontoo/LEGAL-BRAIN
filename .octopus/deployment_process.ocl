step "run-a-script" {
    name = "Run a Script"
    properties = {
        Octopus.Action.TargetRoles = "legal-brain"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                helm install --rollback-on-failure \
                --create-namespace --namespace octopus-agent-legal-brain \
                --version "3.*.*" \
                --set agent.acceptEula="Y" \
                --set agent.space="Default" \
                --set agent.serverUrl="https://legalbrain.octopus.app/" \
                --set agent.serverCommsAddresses="{https://polling.legalbrain.octopus.app/}" \
                --set agent.bearerToken="eyJhbGciOiJQUzI1NiIsImtpZCI6ImExZjg4ZTM0ZTJlNDQyM2M5ZTAxYjE0ZWViMzUzNGViIiwidHlwIjoidm5kLm9jdG9wdXMuYXBpK2p3dCJ9.eyJhdWQiOiJodHRwczovL2xlZ2FsYnJhaW4ub2N0b3B1cy5hcHAiLCJpc3MiOiJodHRwczovL2xlZ2FsYnJhaW4ub2N0b3B1cy5hcHAiLCJleHAiOjE3OTQ2NTUyODEsImlhdCI6MTc5NDY1MTY4MSwibmJmIjoxNzk0NjUxNjgxLCJqdGkiOiJkMzk2YjY4N2FlMjM0NmM4YjljOTNiMTYwZjgwODBkZCIsInN1YiI6ImI4MzAxNmZlLTQ4ODMtNGVhOS04NzcyLWY0ZDI0MjU0YWNiZiJ9.xGH3IPLoEjz183owEa4bmG5avHKwsU935R13l_O45wMdDZQfNLM_vITkLODSYLDg2aCDWdERtecUPGlKQOSPwUQqlENrFx8P3BvvZBqOzi1dOVaatgrl49p3VclZoMS48wF8IBFpgy_vvdZCnNvy1k2JemkDpXoxlWJuVZE-yaOOpdvk6IE2C7hs4zstBdKZq3SiJw8kvxBrn2LQr-IrlgPM9edkaMLSOOW6MrbNn7-2uUiC2sdAbx_U-4s02_uUR62J0e3tcoMKDUwR3lksLB3VIRxF6VMxoPYK0RzUHbiesBizmgj1OaEKKgvRemMHMv8PBEIWLeadr_REKA9o4w" \
                --set agent.name="legal-brain" \
                --set agent.deploymentTarget.initial.environments="{development,production}" \
                --set agent.deploymentTarget.initial.tags="{legal-brain}" \
                --set agent.deploymentTarget.enabled="true" \
                --set agent.deploymentTarget.initial.defaultNamespace="AHMED" \
                --set kubernetesMonitor.enabled="true" \
                --set kubernetesMonitor.registration.serverApiUrl="https://legalbrain.octopus.app/" \
                --set kubernetesMonitor.monitor.serverGrpcUrl="grpc://legalbrain.octopus.app:8443" \
                --set kubernetesMonitor.registration.serverAccessToken="eyJhbGciOiJQUzI1NiIsImtpZCI6ImExZjg4ZTM0ZTJlNDQyM2M5ZTAxYjE0ZWViMzUzNGViIiwidHlwIjoidm5kLm9jdG9wdXMuYXBpK2p3dCJ9.eyJhdWQiOiJodHRwczovL2xlZ2FsYnJhaW4ub2N0b3B1cy5hcHAiLCJpc3MiOiJodHRwczovL2xlZ2FsYnJhaW4ub2N0b3B1cy5hcHAiLCJleHAiOjE3OTQ2NTUyODEsImlhdCI6MTc5NDY1MTY4MSwibmJmIjoxNzk0NjUxNjgxLCJqdGkiOiJkMzk2YjY4N2FlMjM0NmM4YjljOTNiMTYwZjgwODBkZCIsInN1YiI6ImI4MzAxNmZlLTQ4ODMtNGVhOS04NzcyLWY0ZDI0MjU0YWNiZiJ9.xGH3IPLoEjz183owEa4bmG5avHKwsU935R13l_O45wMdDZQfNLM_vITkLODSYLDg2aCDWdERtecUPGlKQOSPwUQqlENrFx8P3BvvZBqOzi1dOVaatgrl49p3VclZoMS48wF8IBFpgy_vvdZCnNvy1k2JemkDpXoxlWJuVZE-yaOOpdvk6IE2C7hs4zstBdKZq3SiJw8kvxBrn2LQr-IrlgPM9edkaMLSOOW6MrbNn7-2uUiC2sdAbx_U-4s02_uUR62J0e3tcoMKDUwR3lksLB3VIRxF6VMxoPYK0RzUHbiesBizmgj1OaEKKgvRemMHMv8PBEIWLeadr_REKA9o4w" \
                --set kubernetesMonitor.registration.spaceId="Spaces-1" \
                --set kubernetesMonitor.registration.machineName="legal-brain" \
                legal-brain \
                oci://registry-1.docker.io/octopusdeploy/kubernetes-agent
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
        worker_pool_variable = ""
    }
}