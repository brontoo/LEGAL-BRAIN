# ==============================================================================
# LEGAL-BRAIN — نموذج متغيّرات البيئة (Backend)
# ==============================================================================
# الاستخدام:
#     cp .env.example .env
#     ثم املأ القيم الفعلية. ملف .env مُستثنى من git — لا ترفعه أبداً.
# ==============================================================================

# --- قاعدة المعرفة (Supabase) ------------------------------------------------
# من: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# ⚠️ تحذير أمني: هذا المفتاح يُستخدم للكتابة (insert) وللبحث (rpc).
# إن استخدمت مفتاح service_role فهو يتجاوز RLS ويملك صلاحية كاملة على القاعدة.
# لا تضعه أبداً في متغيّرات NEXT_PUBLIC_* ولا تُرسله إلى المتصفح.
SUPABASE_KEY=eyJhbGciOi...

# --- النموذج اللغوي (Google Gemini) ------------------------------------------
# من: https://aistudio.google.com/apikey
# يُستخدم في: legal_agent.py (الوكيل الأساسي) و smart_office.py
GOOGLE_API_KEY=AIza...

# --- النموذج البديل (Groq) ---------------------------------------------------
# من: https://console.groq.com/keys
# يُستخدم في: ask_brain.py و test_groq.py (اختياري إن لم تستخدمهما)
GROQ_API_KEY=gsk_...

# --- مجلدات Google Drive (اختياري) -------------------------------------------
# المعرّفات مُعرَّفة في drive_folders.py ومُتتبَّعة في git، فلا حاجة لضبطها هنا.
# استخدم هذا القسم فقط إن أردت تجاوز إحداها بلا لمس الكود:
#     DRIVE_FOLDER_NOTICES=1AbC...
#
# ⚠️ معرّف المجلد ليس سرّاً: وحده لا يمنح أي وصول — الوصول يتم بحساب الخدمة
#    (credentials.json). ولهذا وُضع في ملف إعداد مُتتبَّع بدل هذا الملف المُستثنى.
#
# الأسماء المتاحة: HTML · INGEST_DOCUMENTS · PDF · NOTICES · CONTRACTS · DRAFTS · POA
# DRIVE_FOLDER_HTML=
# DRIVE_FOLDER_INGEST_DOCUMENTS=
# DRIVE_FOLDER_PDF=
# DRIVE_FOLDER_NOTICES=
# DRIVE_FOLDER_CONTRACTS=
# DRIVE_FOLDER_DRAFTS=
# DRIVE_FOLDER_POA=

# --- الخادم (FastAPI) --------------------------------------------------------
# النطاقات المسموح لها بالاتصال (CORS). افصل بينها بفاصلة.
# أضف نطاق الإنتاج هنا قبل النشر. لا تستخدم "*" في الإنتاج.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# عدد أدوار المحادثة المحفوظة لكل جلسة في /chat (يمنع تضخّم السياق)
MAX_HISTORY_TURNS=6
