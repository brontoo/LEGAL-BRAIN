# ==============================================================================
# قواعد موحّدة لمعالجة الملفات في git
# ==============================================================================
# الغرض الأساسي: ضمان أن تبقى سكربتات الشل بنهايات أسطر LF.
#
# السبب: المستودع يُطوَّر على Windows (CRLF) ويُشغَّل على Linux في Codespaces.
# وملف .sh بنهايات CRLF **يفشل على Linux** برسالة مضلّلة:
#     bash: ./dev.sh: /bin/bash^M: bad interpreter: No such file or directory
# أو
#     $'\r': command not found
# وهي أخطاء يُصعب تشخيصها لأن الملف يبدو سليماً في المحرّر.
#
# ملاحظة: لا نفرض قاعدة عامة على كل الملفات (* text=auto) لأن ذلك سيقوم
# بإعادة تطبيع المستودع كله في diff ضخم بلا داعٍ.
# ==============================================================================

# سكربتات الشل — LF دائماً، على كل الأنظمة
*.sh text eol=lf

# الملفات التنفيذية بلا امتداد (لو أُضيفت لاحقاً)
dev text eol=lf
