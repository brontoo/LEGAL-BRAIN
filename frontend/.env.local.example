# ==============================================================================
# LEGAL-BRAIN — نموذج متغيّرات بيئة الواجهة (Next.js)
# ==============================================================================
# الاستخدام:
#     cp .env.local.example .env.local
#
# ⚠️ لاحظ: **لا بادئة NEXT_PUBLIC_ هنا، وهذا مقصود.**
#    هذه المتغيّرات يقرأها خادم Next.js فقط ولا تصل إلى المتصفح إطلاقاً.
#    ولو أضفت NEXT_PUBLIC_ إلى أيّ منها لكُشفت في جافاسكربت المتصفح وأصبحت
#    المصادقة بلا معنى — أي زائر يستطيع قراءتها من مصدر الصفحة.
#
#    السبب في وجودها هنا أصلاً: الوسيط frontend/app/api/[...path]/route.ts
#    يرسل الطلبات إلى FastAPI ويضيف رمز المصادقة من جهة الخادم.
# ==============================================================================

# عنوان خادم FastAPI كما يراه خادم Next.js.
# داخل نفس الحاوية أو Codespaces يكون 127.0.0.1 كافياً — ولا حاجة لجعل المنفذ
# 8000 عاماً إطلاقاً، لأن كل الوصول يمر من جهة الخادم.
BACKEND_URL=http://127.0.0.1:8000

# نفس قيمة API_TOKEN في ملف .env بالجذر.
# اتركه فارغاً إن لم تكن قد ضبطت API_TOKEN في الخادم.
API_TOKEN=
