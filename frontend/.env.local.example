# ==============================================================================
# LEGAL-BRAIN — نموذج متغيّرات بيئة الواجهة (Next.js)
# ==============================================================================
# الاستخدام:
#     cp .env.local.example .env.local
#
# ⚠️ لا تضع أي مفتاح سِرّي هنا. كل متغيّر يبدأ بـ NEXT_PUBLIC_ يُحزَّم داخل
#    جافاسكربت المتصفح ويصبح مرئياً لأي زائر. مفاتيح Supabase و Gemini تعيش
#    في .env الخاص بالخادم (Python) فقط.
# ==============================================================================

# عنوان خادم FastAPI (بدون / في النهاية)
# التطوير المحلي:
NEXT_PUBLIC_API_URL=http://localhost:8000

# مثال للإنتاج (بعد النشر):
# NEXT_PUBLIC_API_URL=https://api.your-domain.ae
